@()
<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fab M3.5 · 3D 数字孪生（Monarch 同源事件驱动）</title>
<style>
  :root { --ok:#1a7f37; --bad:#c62828; --warn:#b26a00; --run:#42a5f5; --bg:#0b1220; --card:rgba(13,23,38,0.85); }
  * { box-sizing:border-box; }
  html, body { margin:0; height:100%; overflow:hidden; font-family:"Microsoft YaHei",system-ui,sans-serif; background:var(--bg); color:#e6edf3; }
  #stage3d { position:fixed; inset:0; }
  .site-nav { position:fixed; top:0; left:0; right:0; z-index:30; background:rgba(11,18,32,0.92); backdrop-filter:blur(10px);
    padding:8px 20px; display:flex; align-items:center; gap:8px; border-bottom:1px solid rgba(255,255,255,0.08); }
  .site-nav .logo { font-weight:700; font-size:0.9rem; color:#fff; text-decoration:none; }
  .site-nav nav { display:flex; gap:6px; margin-left:auto; align-items:center; flex-wrap:wrap; }
  .site-nav nav a { color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.78rem; padding:4px 10px; border-radius:4px; }
  .site-nav nav a:hover { color:#fff; background:rgba(255,255,255,0.1); }
  .site-nav nav a.here { color:#9fe19f; font-weight:600; }
  .hud { position:fixed; z-index:20; background:var(--card); border:1px solid rgba(255,255,255,0.1);
    border-radius:10px; backdrop-filter:blur(8px); padding:10px 12px; font-size:12px; }
  #hudLeft { left:14px; top:64px; width:255px; }
  #hudRight { right:14px; top:64px; width:300px; max-height:62vh; overflow-y:auto; }
  .hud h3 { margin:0 0 8px; font-size:12px; text-transform:uppercase; letter-spacing:1px; color:#8fb8e8; }
  .chip { display:inline-block; padding:3px 10px; border-radius:12px; margin:2px; font-size:11px;
    background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); }
  .chip.on { background:rgba(66,165,245,0.25); border-color:var(--run); color:#cfe8ff; }
  .chip.done { background:rgba(26,127,55,0.25); border-color:var(--ok); color:#c9f0cf; }
  .chip.fail { background:rgba(198,40,40,0.3); border-color:var(--bad); color:#ffd2cd; }
  .feed { max-height:50vh; overflow-y:auto; font-family:Consolas,monospace; font-size:11px; line-height:1.8; color:#9fe19f; }
  .feed .err { color:#ff9b8a; }
  .kpi { display:flex; gap:8px; margin:6px 0; flex-wrap:wrap; }
  .kpi .chip b { color:#fff; }
  #banner { position:fixed; top:52px; left:50%; transform:translateX(-50%); z-index:40;
    padding:10px 22px; border-radius:10px; font-size:14px; font-weight:600; display:none; }
  #banner.recovering { display:block; background:rgba(255,152,0,0.92); color:#1a1a1a; }
  #banner.crash { display:block; background:rgba(198,40,40,0.92); color:#fff; }
  #banner.done { display:block; background:rgba(26,127,55,0.92); color:#fff; }
  .btnrow { display:flex; gap:8px; margin-top:8px; }
  .btnrow button { flex:1; padding:8px 0; border:none; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600; }
  #btnStart { background:var(--ok); color:#fff; } #btnCrash { background:var(--bad); color:#fff; }
  #btnStart:disabled { background:#455a64; }
  .hint { font-size:11px; color:#789; margin-top:6px; line-height:1.6; }
</style>
<script type="importmap">
{ "imports": {
    "three": "/javascripts/lib/three/0.160.0/three.module.min.js",
    "three/addons/": "/javascripts/lib/three/0.160.0/examples/jsm/"
} }
</script>
</head>
<body>
<div class="site-nav">
  <a href="/" class="logo">Reactive MES Kernel</a>
  <nav>
    <a href="/">首页</a>
    <a href="/saga">M1 Saga</a>
    <a href="/m2">M2 DAG</a>
    <a href="/m3">M3</a>
    <a href="/fab-demo/m35">2D 演示</a>
    <a href="/bank-batch">银行批量</a>
    <a href="/fab-demo/m35-3d" class="here">3D 孪生</a>
  </nav>
</div>

<div id="stage3d"></div>
<div id="banner"></div>

<div class="hud" id="hudLeft">
  <h3>工序游标（17 道链）</h3>
  <div id="stageChips"></div>
  <h3 style="margin-top:12px">运行状态</h3>
  <div class="kpi">
    <span class="chip">在途 <b id="kpiWip">0</b></span>
    <span class="chip">恢复 <b id="kpiRec">0</b></span>
    <span class="chip">OCAP <b id="kpiOcap">0</b></span>
  </div>
  <div class="btnrow">
    <button id="btnStart">▶ 启动自愈演示</button>
    <button id="btnCrash">⚡ 注入宕机</button>
  </div>
  <div class="btnrow">
    <button id="btnCam">🎥 跟随 OHT</button>
  </div>
  <p class="hint">3D 场景由 /ws/fab-demo/m35/events 的真实引擎事件驱动：FoupInTransit 移动天车、ProcessingStarted 点亮设备、宕机恢复从断点续跑。工位布局：STOCKER → LITHO-01 → CDSEM-01 → 返工岛。</p>
</div>

<div class="hud" id="hudRight">
  <h3>事件流（真实引擎事件）</h3>
  <div class="feed" id="feed"></div>
</div>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

/* ================= 渲染基础 ================= */
const container = document.getElementById('stage3d');
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
container.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0b1220);
scene.fog = new THREE.Fog(0x0b1220, 42, 130);

const camera = new THREE.PerspectiveCamera(55, innerWidth/innerHeight, 0.1, 300);
camera.position.set(2, 17, 21);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.target.set(0, 1, 0);

scene.add(new THREE.AmbientLight(0xbfd4ff, 0.55));
const key = new THREE.DirectionalLight(0xffffff, 1.5);
key.position.set(14, 28, 12);
key.castShadow = true;
key.shadow.mapSize.set(2048, 2048);
Object.assign(key.shadow.camera, { left:-32, right:32, top:32, bottom:-32 });
scene.add(key);
const fill = new THREE.PointLight(0x88aaff, 0.45, 70); fill.position.set(-14, 12, -10); scene.add(fill);

addEventListener('resize', () => {
  camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

/* ================= 洁净室 ================= */
const floor = new THREE.Mesh(
  new THREE.PlaneGeometry(48, 32),
  new THREE.MeshStandardMaterial({ color: 0x1a2634, roughness: 0.85, metalness: 0.1 }));
floor.rotation.x = -Math.PI/2; floor.receiveShadow = true; scene.add(floor);
const grid = new THREE.GridHelper(48, 48, 0x2a3b52, 0x1c2a3c);
grid.position.y = 0.01; scene.add(grid);

const wallMat = new THREE.MeshStandardMaterial({ color: 0x14202e, transparent: true, opacity: 0.35, roughness: 0.4 });
[[0,-16,48,0.3],[0,16,48,0.3]].forEach(([x,z,w,d]) => {
  const wall = new THREE.Mesh(new THREE.BoxGeometry(w, 6, d), wallMat);
  wall.position.set(x, 3, z); scene.add(wall);
});
[[-24,0],[24,0]].forEach(([x,z]) => {
  const wall = new THREE.Mesh(new THREE.BoxGeometry(0.3, 6, 32), wallMat);
  wall.position.set(x, 3, z); scene.add(wall);
});
[4,-4].forEach(z => {
  const truss = new THREE.Mesh(new THREE.BoxGeometry(46, 0.45, 0.8),
    new THREE.MeshStandardMaterial({ color: 0x37474f, metalness: 0.8, roughness: 0.3 }));
  truss.position.set(0, 5.6, z); scene.add(truss);
});

/* ================= 站位（链序布局 + 返工岛） ================= */
const AREA_POS = {
  STOCKER: new THREE.Vector3(-15, 0, 0),
  LITHO:   new THREE.Vector3(-3.5, 0, 0),
  CDSEM:   new THREE.Vector3( 9,  0, 0),
  REWORK:  new THREE.Vector3( 3,  0, 8.5),
  STOCKER2:new THREE.Vector3( 15, 0, 0),
};

function base(w, h, d, color) {
  const g = new THREE.Group();
  const body = new THREE.Mesh(new THREE.BoxGeometry(w, h, d),
    new THREE.MeshStandardMaterial({ color, metalness: 0.6, roughness: 0.35 }));
  body.position.y = h/2; body.castShadow = true; body.receiveShadow = true; g.add(body);
  const panel = new THREE.Mesh(new THREE.PlaneGeometry(w*0.5, 0.7),
    new THREE.MeshStandardMaterial({ color: 0x0aa8a0, emissive: 0x0aa8a0, emissiveIntensity: 0.7 }));
  panel.position.set(0, h*0.72, d/2 + 0.01); g.add(panel);
  g.userData.panel = panel;
  return g;
}
function loadPort(g, x, z) {
  const port = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.25, 1.2),
    new THREE.MeshStandardMaterial({ color: 0x263238, metalness: 0.5, roughness: 0.4 }));
  port.position.set(x, 1.05, z); g.add(port);
}

/* LITHO-01 */
const litho = base(5, 3.4, 3, 0x283593);
const win = new THREE.Mesh(new THREE.PlaneGeometry(1.8, 1.1),
  new THREE.MeshStandardMaterial({ color: 0x111111, emissive: 0x40c4ff, emissiveIntensity: 0.9 }));
win.position.set(0, 2.2, 1.52); litho.add(win);
litho.userData.win = win;
const duct = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 1.2, 12),
  new THREE.MeshStandardMaterial({ color: 0x90a4ae, metalness: 0.7, roughness: 0.3 }));
duct.position.set(1.4, 4.0, 0); litho.add(duct);
loadPort(litho, -2.1, 1.9);
litho.position.copy(AREA_POS.LITHO); scene.add(litho);

/* CDSEM-01 */
const cdsem = new THREE.Group();
const col = new THREE.Mesh(new THREE.CylinderGeometry(0.55, 0.8, 2.6, 16),
  new THREE.MeshStandardMaterial({ color: 0x37474f, metalness: 0.75, roughness: 0.3 }));
col.position.y = 1.3; col.castShadow = true; cdsem.add(col);
const chamber = new THREE.Mesh(new THREE.BoxGeometry(2.2, 1.1, 2.2),
  new THREE.MeshStandardMaterial({ color: 0x263238, metalness: 0.5, roughness: 0.4 }));
chamber.position.y = 0.55; cdsem.add(chamber);
const gunTip = new THREE.Mesh(new THREE.ConeGeometry(0.28, 0.5, 12),
  new THREE.MeshStandardMaterial({ color: 0x0aa8a0, emissive: 0x0aa8a0, emissiveIntensity: 0.8 }));
gunTip.position.set(0, 1.05, 1.15); gunTip.rotation.x = Math.PI/2; cdsem.add(gunTip);
loadPort(cdsem, 0, 1.4);
cdsem.position.copy(AREA_POS.CDSEM); scene.add(cdsem);

/* STOCKER × 2 */
function stockerAt(pos) {
  const g = new THREE.Group();
  const frame = new THREE.Mesh(new THREE.BoxGeometry(4.6, 3.2, 1.4),
    new THREE.MeshStandardMaterial({ color: 0x1c2a3a, metalness: 0.4, roughness: 0.5 }));
  frame.position.y = 1.6; g.add(frame);
  for (let r = 0; r < 3; r++) for (let c = 0; c < 5; c++) {
    const slot = new THREE.Mesh(new THREE.BoxGeometry(0.52, 0.62, 0.5),
      new THREE.MeshStandardMaterial({ color: 0x00838f, emissive: 0x006064, emissiveIntensity: 0.35 }));
    slot.position.set(-1.8 + c*0.9, 0.55 + r*0.95, 0.5); g.add(slot);
  }
  g.position.copy(pos); scene.add(g); return g;
}
stockerAt(AREA_POS.STOCKER);
stockerAt(AREA_POS.STOCKER2);

/* REWORK 岛 */
const rework = base(2.6, 1.8, 2, 0x4e342e);
rework.position.copy(AREA_POS.REWORK); scene.add(rework);
const rwTag = new THREE.Mesh(new THREE.PlaneGeometry(2.2, 0.5),
  new THREE.MeshStandardMaterial({ color: 0x4e342e, emissive: 0xbf360c, emissiveIntensity: 0.5 }));
rwTag.position.set(0, 2.3, 0); rework.add(rwTag);

/* ================= OHT 天车 + FOUP ================= */
const trackPts = [AREA_POS.STOCKER, AREA_POS.LITHO, AREA_POS.CDSEM, AREA_POS.STOCKER2]
  .map(p => new THREE.Vector3(p.x, 5.15, p.z));
const track = new THREE.Mesh(
  new THREE.TubeGeometry(new THREE.CatmullRomCurve3(trackPts, false, 'catmullrom', 0.1), 140, 0.09, 8),
  new THREE.MeshStandardMaterial({ color: 0x546e7a, metalness: 0.8, roughness: 0.3 }));
scene.add(track);

const oht = new THREE.Group();
const bridge = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.28, 0.7),
  new THREE.MeshStandardMaterial({ color: 0xffb300, metalness: 0.6, roughness: 0.3 }));
oht.add(bridge);
const trolley = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.5, 0.5),
  new THREE.MeshStandardMaterial({ color: 0xffcc80 }));
trolley.position.y = -0.45; oht.add(trolley);
const beacon = new THREE.Mesh(new THREE.SphereGeometry(0.12, 10, 10),
  new THREE.MeshStandardMaterial({ color: 0x1a7f37, emissive: 0x1a7f37, emissiveIntensity: 1.2 }));
beacon.position.set(0, 0.3, 0); oht.add(beacon); oht.userData.beacon = beacon;
scene.add(oht);

const foup = new THREE.Group();
const foupBody = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.55, 0.55),
  new THREE.MeshStandardMaterial({ color: 0xeceff1, metalness: 0.3, roughness: 0.4 }));
foupBody.position.y = -0.85; foup.add(foupBody);
const led = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 8),
  new THREE.MeshStandardMaterial({ color: 0x00e676, emissive: 0x00e676, emissiveIntensity: 1.5 }));
led.position.set(0.2, -0.62, 0.28); foup.add(led); foup.userData.led = led;
foup.visible = false; oht.add(foup);

/* ================= HUD ================= */
const STAGES = ["LoadFoup","Transport","AtEquipment","TrackIn","RunRecipe","TrackOut",
  "Transport","AtEquipment","TrackIn","Measure","TrackOut","Classify","M35Classify","OCAP","AwaitSubLot","Transport","Seal"];
const chipsEl = document.getElementById('stageChips');
STAGES.forEach((s, i) => {
  const c = document.createElement('span');
  c.className = 'chip'; c.id = 'chip-' + i; c.textContent = (i+1) + '·' + s;
  chipsEl.appendChild(c);
});
function chipState(i, cls) { const el = document.getElementById('chip-' + i); if (el) el.className = 'chip ' + cls; }
function feedAdd(line, isErr) {
  const el = document.getElementById('feed');
  const div = document.createElement('div');
  if (isErr) div.className = 'err';
  div.textContent = line;
  el.prepend(div);
  while (el.children.length > 60) el.removeChild(el.lastChild);
}
const bannerEl = document.getElementById('banner');
let bannerT;
function banner(text, cls) {
  bannerEl.textContent = text; bannerEl.className = 'banner ' + (cls || '');
  clearTimeout(bannerT); bannerT = setTimeout(() => { bannerEl.className = ''; }, 6000);
}
const startBtn = document.getElementById('btnStart');
const crashBtn = document.getElementById('btnCrash');
let activeWo = null, stageDone = 0;

startBtn.addEventListener('click', () => {
  startBtn.disabled = true; banner("🚀 启动自愈演示……", "recovering");
  fetch("/api/fab-demo/m35/start", {method:"POST"}).then(r => r.json());
});
crashBtn.addEventListener('click', () => {
  if (!activeWo) return;
  fetch("/api/fab-demo/m35/inject-crash/" + activeWo, {method:"POST"});
  banner("⚡ 宕机已注入——账本已保存，断点续跑即将开始", "crash");
});
const camBtn = document.getElementById('btnCam');
let follow = false;
camBtn.addEventListener('click', () => { follow = !follow; camBtn.textContent = follow ? "🎥 跟随中（点击取消）" : "🎥 跟随 OHT"; });

/* ================= 事件驱动 ================= */
const AREA_TO_I = { STOCKER: 0, LITHO: 1, CDSEM: 2 };
const equipByArea = { LITHO: litho, CDSEM: cdsem };
let moveAnim = null, recoveries = 0, ocapCount = 0;

function beacon(c) { oht.userData.beacon.material.color.set(c); oht.userData.beacon.material.emissive.set(c); }
function panel(area, color, i) {
  const e = equipByArea[area]; if (!e || !e.userData.panel) return;
  e.userData.panel.material.color.set(color);
  e.userData.panel.material.emissive.set(color);
  e.userData.panel.material.emissiveIntensity = i;
}
function moveOHT(fromArea, toArea, etaMs) {
  const from = AREA_POS[fromArea.toUpperCase()] || AREA_POS.STOCKER;
  const to = AREA_POS[toArea.toUpperCase()] || AREA_POS.CDSEM;
  foup.visible = true; beacon(0xffb300);
  moveAnim = {
    p0: new THREE.Vector3(from.x, 5.15, from.z),
    p1: new THREE.Vector3(to.x, 5.15, to.z),
    t0: performance.now(), eta: Math.max(500, Math.min(etaMs || 1200, 6000))
  };
}

const wsUrl = (location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/ws/fab-demo/m35/events";
let ws;
function connect() {
  ws = new WebSocket(wsUrl);
  ws.onmessage = ev => handle(JSON.parse(ev.data));
  ws.onclose = () => setTimeout(connect, 2000);
  ws.onerror = () => ws.close();
}
function handle(frame) {
  const t = frame.type, d = frame.data || {};
  switch (t) {
    case "DemoStarted":
      activeWo = d.workOrderId || null;
      window.__activeWo = activeWo;
      stageDone = 0;
      for (let i = 0; i < STAGES.length; i++) chipState(i, "");
      banner("🚀 演示启动：" + (d.waferCount || 5) + " 片晶圆入库", "recovering");
      feedAdd("▶ 演示启动（" + (d.waferCount || 5) + " 片）");
      break;
    case "FoupInTransit":
      moveOHT(d.fromArea, d.toArea, d.etaMs); break;
    case "FoupArrivedAtPort":
      foup.visible = false; beacon(0x1a7f37); break;
    case "ProcessingStarted": {
      const area = Object.keys(equipByArea).find(k => (d.equipmentId||"").includes(k));
      if (area) panel(area, 0xffb300, 1.4);
      chipState(9, "on");
      break;
    }
    case "ProcessingCompleted": {
      const area = Object.keys(equipByArea).find(k => (d.jobId||"").includes(k));
      if (area) panel(area, 0x00e676, 1.0);
      break;
    }
    case "EquipmentStateChanged":
      if (d.areaId) panel(d.areaId, d.status === "RUN" ? 0x00e676 : (d.status === "DOWN" ? 0xff5252 : 0xffb300), 1.0);
      break;
    case "MeasurementResultEvent":
      feedAdd("📏 " + d.waferId + " CD=" + d.cdNm + "nm → " + d.classification);
      break;
    case "PipelineStageFailed":
      feedAdd("❌ 阶段失败 " + (d.phase || "") + "：" + (d.detail || ""), true);
      banner("❌ 阶段失败：" + (d.detail || ""), "crash");
      break;
    case "OcapActionTriggered":
      ocapCount++; document.getElementById("kpiOcap").textContent = ocapCount;
      banner("🛠 OCAP 拦截：" + (d.actionType || "处置"), "recovering");
      feedAdd("🛠 OCAP：" + JSON.stringify(d.data || d).slice(0, 120));
      break;
    case "DynamicStageInjected":
      feedAdd("🧬 动态织入阶段：" + (d.injectedStageType || ""));
      break;
    case "RecoveryEvent":
      if ((d.status || "") === "RECOVERING") {
        recoveries++; document.getElementById("kpiRec").textContent = recoveries;
        banner("🔄 [" + (d.batchId || "") + "] 宕机恢复：前 " + (d.phasesSkipped ?? "?") + " 道不重做", "recovering");
        feedAdd("🔄 断点续跑（" + (d.phasesSkipped ?? "?") + " 道已完成）");
      }
      break;
    case "GlobalStatusChanged":
      if ((d.status || "").includes("Complete")) {
        banner("✅ 全部批次完成 — 终态对账守恒", "done");
        setButtons(false); startBtn.disabled = false;
      }
      break;
    case "AggregateStateUpdated": {
      const st = frame.data && frame.data.state;
      if (st && st.amounts) {
        document.getElementById("kpiAmtR").textContent = (st.amounts.rechargeCredited||0).toLocaleString();
        document.getElementById("kpiAmtP").textContent = (st.amounts.purchasePaid||0).toLocaleString();
        document.getElementById("kpiPos").textContent = (st.amounts.position||0).toLocaleString();
      }
      break;
    }
  }
}
connect();

/* ================= 渲染循环（OHT 运动 + 脉冲 + 相机） ================= */
const clock = new THREE.Clock();
function animate() {
  requestAnimationFrame(animate);
  const dt = clock.getDelta();
  const now = performance.now();
  if (moveAnim) {
    const k = Math.min(1, (now - moveAnim.t0) / moveAnim.eta);
    const e = k < 0.5 ? 2*k*k : 1 - Math.pow(-2*k + 2, 2)/2; // easeInOut
    oht.position.lerpVectors(moveAnim.p0, moveAnim.p1, e);
    if (k >= 1) { moveAnim = null; beacon(0x1a7f37); }
  }
  litho.userData.win.material.emissiveIntensity = 0.9 + Math.sin(now*0.004)*0.3;
  const pulse = 0.7 + Math.sin(now*0.006)*0.5;
  Object.values(equipByArea).forEach(e => {
    if (e.userData.pulseUntil && now < e.userData.pulseUntil)
      e.userData.panel.material.emissiveIntensity = 1.2 + Math.sin(now*0.01)*0.6;
  });
  beacon.material.emissiveIntensity = 1.0 + Math.sin(now*0.008)*0.6;
  if (follow) {
    camera.position.lerp(new THREE.Vector3(oht.position.x + 4, oht.position.y + 6, oht.position.z + 8), 0.04);
    controls.target.lerp(new THREE.Vector3(oht.position.x, 2, oht.position.z), 0.06);
  }
  controls.update();
  renderer.render(scene, camera);
}
animate();

document.getElementById("btnCam").addEventListener("click", function(){
  follow = !follow;
  this.textContent = follow ? "🎥 跟随中（点击取消）" : "🎥 跟随 OHT";
});
document.getElementById("btnStart").addEventListener("click", function(){
  this.disabled = true; banner("🚀 启动自愈演示……", "recovering");
  fetch("/api/fab-demo/m35/start", {method:"POST"}).then(r => r.json()).then(j => {
    banner("🚀 已启动：" + (j.message || j.workOrderId || ""), "recovering");
    this.disabled = false;
  });
});
document.getElementById("btnCrash").addEventListener("click", function(){
  if (!window.__activeWo) { banner("⚠ 暂无运行中的批次", "recovering"); return; }
  fetch("/api/fab-demo/m35/inject-crash/" + window.__activeWo, {method:"POST"});
  banner("⚡ 宕机已注入——账本已保存，断点续跑即将开始", "crash");
});
/* DemoStarted 里捕获 activeWo（宕机按钮目标） */
const _origHandle = handle;
</script>
</body>
</html>
