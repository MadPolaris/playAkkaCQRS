GET     /m3-roadmap                 controllers.DddGuideController.m3Roadmap()
GET     /en/m3-roadmap              controllers.DddGuideController.m3RoadmapEn()
GET     /m3-demo                    controllers.DddGuideController.m3Demo()
GET     /api/projection/status      controllers.DddGuideController.getProjectionStatus()
GET     /api/aggregate/balances/:ids controllers.DddGuideController.getBalances(ids: String)

# Fab Demo
GET     /fab-demo                               controllers.FabDemoController.index()
GET     /fab-designer                           controllers.FabDemoController.designer()
GET     /ws/fab-demo/events                     controllers.FabDemoController.socket
POST    /api/fab-demo/start/:scenarioId          controllers.FabDemoController.startDemo(scenarioId: String)
POST    /api/fab-demo/product/:productId/start   controllers.FabDemoController.startProductDemo(productId: String)
GET     /api/fab-demo/scenarios                  controllers.FabDemoController.getScenarios
GET     /api/fab-demo/scenario/:id/ledger        controllers.FabDemoController.getScenarioLedger(id: String)
